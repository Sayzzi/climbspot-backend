# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Supabase Postgres connection string: Connect > Direct > Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Terrain elevation API (Open-Meteo by default, see docs/adr/0005)
ELEVATION_API_URL=https://api.open-meteo.com/v1/elevation

# Supabase project whose Auth identifies signed-in Visitors (ADR 0009):
# Project Settings → API → Project URL.
SUPABASE_URL=https://your-project.supabase.co
# Secret service-role key (Project Settings → API keys), to delete accounts. Never expose it.
# SUPABASE_SERVICE_ROLE_KEY=

# ClimbSpot's Strava application (strava.com/settings/api, callback domain: localhost),
# and 32 random bytes encrypting stored Strava tokens (openssl rand -base64 32).
# Without them, connecting to Strava answers that it is unavailable.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_TOKEN_KEY=
# STRAVA_REDIRECT_URL=http://localhost:5173/strava/callback

# OpenRouteService, used to plan Itineraries (ADR 0008). Either the self-hosted one
# from routing/ (no key, no quota, see the README):
# ORS_URL=http://localhost:8080/ors
# or the hosted API, which needs a free key (about 200 directions a day):
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your-openrouteservice-key
